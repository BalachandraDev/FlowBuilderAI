{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning"
      }
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=FlowCapture;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": { "Provider": "SqlServer" },

  "Security": {
    "JwtIssuer": "flowcapture",
    "JwtAudience": "flowcapture-clients",
    "JwtSigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },

  "Ai": {
    "Provider": "Gemini",
    "GeminiModel": "",
    "Model": "claude-sonnet-5-5",
    "MaxTokens": 16000,
    "Effort": "medium",
    "DisableThinking": false,
    "MonthlyTokenLimitGlobal": 0,
    "PricePerMTokInput": 2.00,
    "PricePerMTokOutput": 10.00,
    "PricePerMTokCacheRead": 0.10
  },
  "Anthropic": { "ApiKey": "", "TimeoutSeconds": 300, "MaxRetries": 2 },
  "Gemini": { "ApiKey": "", "TimeoutSeconds": 300 },

  "Stt": { "Provider": "None", "Region": "", "Key": "", "ApiVersion": "2024-11-15" },

  "Storage": { "Provider": "FileSystem", "RootPath": "App_Data/blobs", "ConnectionString": "", "Container": "flowcapture" },

  "Capture": { "AudioMaxMinutes": 30, "DefaultLanguage": "en-IN" },

  "Jobs": { "Mode": "Hangfire", "Workers": 4 },
  "Hangfire": { "Dashboard": false },

  "Swagger": { "Enabled": false },
  "Https": { "Redirect": true },
  "RateLimit": { "AuthPerMinute": 10 },

  "Prompts": { "Path": "" },
  "Seed": { "AdminEmail": "", "AdminPassword": "", "AdminName": "Administrator" }
}
