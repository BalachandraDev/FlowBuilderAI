# Copy to .env (never commit .env) and fill in.

# SQL Server SA password: 8+ characters with upper, lower, digit and symbol.
SQL_SA_PASSWORD=

# The port FlowCapture (web app and API) listens on, on this machine (optional).
API_PORT=8080

# Secret that signs sign-in tokens: 32+ random characters. Changing it signs everybody out.
JWT_SIGNING_KEY=

# The first administrator, created only when the database has no users yet. Change the password after the first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI (analysis, the guide, voice notes, photos). Leave these empty: the administrator pastes the free Google Gemini key
# into the app (AI setup) after signing in. Fill GEMINI_API_KEY only for a fixed deployment with no admin step.
GEMINI_API_KEY=
# Optional: use Claude instead (text only, paid).
ANTHROPIC_API_KEY=

# Voice notes use Gemini by default. Set Azure here only if you prefer Azure Speech for them (then set the region and key).
STT_PROVIDER=None
STT_REGION=
STT_KEY=
