{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flowcapture:schema:project-analysis:1.0",
  "title": "FlowCapture whole-project (cross-department) analysis v1",
  "description": "Result of analysing several department flows together. Flows are referenced as F# (assigned per request by the server). This result never rewrites a flow; it only proposes links, duplicates, conflicts and questions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "summary", "handoffs", "duplicates", "conflicts",
    "gaps", "clarificationQuestions", "combinedMermaid", "confidence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "summary": { "type": "string", "minLength": 1 },
    "handoffs": { "type": "array", "items": { "$ref": "#/$defs/handoff" } },
    "duplicates": { "type": "array", "items": { "$ref": "#/$defs/duplicate" } },
    "conflicts": { "type": "array", "items": { "$ref": "#/$defs/conflict" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "clarificationQuestions": { "type": "array", "items": { "$ref": "#/$defs/question" } },
    "combinedMermaid": {
      "description": "End-to-end flowchart, one subgraph per department, cross-department links dashed. The server regenerates it deterministically from the flows and the ACCEPTED handoffs.",
      "type": "string",
      "minLength": 10
    },
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["handoffs", "conflictsAndDuplicates"],
      "properties": {
        "handoffs": { "$ref": "#/$defs/score" },
        "conflictsAndDuplicates": { "$ref": "#/$defs/score" }
      }
    }
  },
  "$defs": {
    "score": { "type": "number", "minimum": 0, "maximum": 1 },
    "flowRef": { "type": "string", "pattern": "^F[0-9]{1,3}$" },
    "itemRef": {
      "type": "object", "additionalProperties": false,
      "required": ["flowRef", "itemId"],
      "properties": {
        "flowRef": { "$ref": "#/$defs/flowRef" },
        "itemId": { "description": "Id of a step, decision, rule or other item inside that flow, e.g. S4, D1, BR2.", "type": "string", "pattern": "^[A-Z]{1,5}[0-9]{1,4}$" }
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "description", "dataPassed", "basis", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^H[0-9]{1,3}$" },
        "from": { "$ref": "#/$defs/itemRef" },
        "to": { "$ref": "#/$defs/itemRef" },
        "description": { "type": "string", "minLength": 1 },
        "dataPassed": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "basis": { "enum": ["Stated in both flows", "Stated in one flow", "Implied - needs confirmation"] },
        "evidence": { "description": "Short quote or paraphrase of the flow text that justifies the link.", "type": "string", "minLength": 1 }
      }
    },
    "duplicate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "flowRefs", "description", "recommendation"],
      "properties": {
        "id": { "type": "string", "pattern": "^DUP[0-9]{1,3}$" },
        "flowRefs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/flowRef" } },
        "description": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 }
      }
    },
    "conflict": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "flowRefs", "itemRefs", "description", "severity", "suggestedQuestion"],
      "properties": {
        "id": { "type": "string", "pattern": "^CON[0-9]{1,3}$" },
        "flowRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/flowRef" } },
        "itemRefs": { "type": "array", "items": { "$ref": "#/$defs/itemRef" } },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["High", "Medium", "Low"] },
        "suggestedQuestion": { "type": "string", "minLength": 1 }
      }
    },
    "gap": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "flowRefs", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^G[0-9]{1,3}$" },
        "flowRefs": { "type": "array", "items": { "$ref": "#/$defs/flowRef" } },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "flowRefs", "question"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q[0-9]{1,3}$" },
        "flowRefs": { "type": "array", "items": { "$ref": "#/$defs/flowRef" } },
        "question": { "type": "string", "minLength": 1 },
        "relatedGapId": { "type": "string", "pattern": "^G[0-9]{1,3}$" }
      }
    }
  }
}
